{
  "permissions": {
    "deny": [
      "Read(//etc/claude-code/**)",
      "Read(//run/host-ssh/**)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Read(~/.claude/history.jsonl)",
      "Read(~/.claude/projects/**)",
      "Read(~/.codex/**)",
      "Read(~/.config/gh/**)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.env.local)",
      "Read(./.env.development)",
      "Read(./**/.env.development)",
      "Read(./.env.test)",
      "Read(./**/.env.test)",
      "Read(./.env.staging)",
      "Read(./**/.env.staging)",
      "Read(./.env.production)",
      "Read(./**/.env.production)",
      "Bash(sudo:*)"
    ]
  },
  "env": {
    "DISABLE_UPDATES": "1",
    "DISABLE_AUTOUPDATER": "1"
  }
}

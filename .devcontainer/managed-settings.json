{
  "permissions": {
    "deny": [
      "Read(/etc/claude-code/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.ssh/**)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)"
    ]
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  }
}

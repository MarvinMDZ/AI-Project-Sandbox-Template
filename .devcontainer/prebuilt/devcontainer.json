{
  // The sandbox image the template publishes on every release tag, pulled instead of built.
  // Pick this configuration in "Reopen in Container". Its metadata already carries the
  // docker-outside-of-docker feature, remoteUser, containerEnv, the named volumes, init and
  // post-start.sh, so none of that is repeated here. remoteEnv and the ~/.ssh bind mount are
  // repeated because their ${localEnv:...} values must resolve on this host; same variables
  // and same mount target, so the merge keeps one of each. A pulled image does not run
  // .devcontainer/project.sh: keep the build configuration when you need project tools.
  // The tag must equal .ai/TEMPLATE_VERSION; the publish workflow checks it.
  "name": "sandbox (prebuilt)",
  "image": "ghcr.io/marvinmdz/ai-project-sandbox:v1.0.0",
  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}",
    "GH_TOKEN": "${localEnv:GH_TOKEN}",
    "TUNNEL_TOKEN": "${localEnv:CLOUDFLARE_TUNNEL_TOKEN}"
  },
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/run/host-ssh,type=bind,readonly"
  ]
}

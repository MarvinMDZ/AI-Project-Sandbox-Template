{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness/schemas/task.schema.json",
  "title": "Task",
  "description": "One unit of delegated implementation work, taken from a plan in docs/plans/.",
  "type": "object",
  "required": ["id", "plan", "objective", "acceptance_criteria", "files", "validation", "risk"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^P[0-9]{3}-T[0-9]{3}$", "description": "Plan-scoped id, e.g. P001-T002." },
    "plan": { "type": "string", "pattern": "^P[0-9]{3}$" },
    "phase": { "type": "integer", "minimum": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "files": { "type": "array", "items": { "type": "string" }, "description": "Paths the task is expected to touch. Anything else is out of scope." },
    "validation": { "type": "array", "items": { "type": "string" }, "description": "Commands that must pass before the task is complete." },
    "risk": { "enum": ["low", "medium", "high"] },
    "depends_on": { "type": "array", "items": { "type": "string" } },
    "context": { "type": "array", "items": { "type": "string" }, "description": "Extra files, decisions (DEC-###) or docs the agent should read first." }
  }
}
